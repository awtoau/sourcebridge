{
  "schema_version": 1,
  "id": "sourcebridge-validation-fixture",
  "kind": "frontend",
  "version": "0.1.0",
  "provides": {
    "source_languages": [
      "fixture-source"
    ],
    "target_environments": []
  },
  "entrypoints": {
    "validation": {
      "id": "fixture-validation-v1",
      "command": [
        "python3",
        "adapter.py"
      ],
      "source": "adapter.py",
      "timeout_seconds": 5
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awtoau/sourcebridge/schemas/rule-proposal.schema.json",
  "title": "Sourcebridge local-model rule proposal",
  "type": "object",
  "required": [
    "rule_name",
    "family",
    "applicability",
    "status_claim",
    "description",
    "positive_patterns",
    "negative_patterns",
    "suggested_tests",
    "open_questions"
  ],
  "properties": {
    "rule_name": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "applicability": {
      "type": "object",
      "required": ["source_language", "version_selector", "variant_selector", "rationale"],
      "properties": {
        "source_language": {
          "type": "string"
        },
        "version_selector": {
          "type": "object"
        },
        "variant_selector": {
          "type": "object"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status_claim": {
      "const": "unvalidated-llm-proposal"
    },
    "description": {
      "type": "string"
    },
    "positive_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["snippet", "why_it_matches"],
        "properties": {
          "snippet": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "why_it_matches": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "negative_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["snippet", "why_it_must_not_match"],
        "properties": {
          "snippet": {
            "type": "string"
          },
          "why_it_must_not_match": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "suggested_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_input", "expected_result"],
        "properties": {
          "source_input": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "observed_input": {},
          "variant": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_template": {
      "type": "object",
      "required": ["target_backend", "template"],
      "properties": {
        "target_backend": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awtoau/sourcebridge/schemas/pack-manifest.schema.json",
  "title": "Sourcebridge pack manifest",
  "type": "object",
  "required": ["schema_version", "id", "kind", "version", "provides"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "enum": ["frontend", "corpus", "backend", "runtime"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provides": {
      "type": "object",
      "required": ["source_languages", "target_environments"],
      "properties": {
        "source_languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "target_environments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

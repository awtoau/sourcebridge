{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awtoau/sourcebridge/schemas/profile.schema.json",
  "title": "Sourcebridge conversion profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "source_frontend",
    "target_backend",
    "rule_layers",
    "runtime_adapters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source_frontend": {
      "type": "string"
    },
    "corpus_pack": {
      "type": "string"
    },
    "target_backend": {
      "type": "string"
    },
    "rule_layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtime_adapters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "component_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_selector", "disposition", "rationale"],
        "properties": {
          "source_selector": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "direct_translation",
              "retain_runtime",
              "runtime_replacement",
              "native_reimplementation",
              "external_dependency",
              "stubbed_boundary",
              "excluded",
              "blocked"
            ]
          },
          "target_backend": {
            "type": "string"
          },
          "runtime_adapter": {
            "type": "string"
          },
          "boundary_contract": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "options": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
